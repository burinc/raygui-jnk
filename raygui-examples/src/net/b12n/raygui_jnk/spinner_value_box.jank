(ns net.b12n.raygui-jnk.spinner-value-box
  "raygui [inputs] - spinner and value box, clamped and typed.

  Both hold an int cell and clamp to a min/max; both take a plain-bool edit
  mode the caller owns. The spinner adds -/+ buttons, the value box is
  keyboard-only. The third spinner is seeded ABOVE its maximum to show the
  clamp actually holding."
  (:require [net.b12n.raygui-jnk.raygui :as g]
            [net.b12n.raygui-jnk.raylib :as rl])
  (:include "raylib.h" "rlgl.h"))

(def WIDTH 440)
(def HEIGHT 260)

(defn -main [& args]
  (cpp/InitWindow WIDTH HEIGHT "raygui [inputs] - spinner and value box (jank)")
  (cpp/SetTargetFPS 60)
  (let [deadline (rl/auto-quit-ms)
        shot     (rl/shot-path)
        count'   (g/icell 4)
        volume   (g/icell 60)
        clamped  (g/icell 999)
        e1       (g/bcell false)
        e2       (g/bcell false)
        e3       (g/bcell false)]
    (loop [frame 0]
      (cpp/BeginDrawing)
      (g/clear-background!)

      (g/label! 20.0 14.0 400.0 20.0 "GuiSpinner - buttons plus typing")
      (when (pos? (g/spinner! 150.0 38.0 150.0 30.0 "count  " count' 0 10 (g/bvalue e1)))
        (g/breset! e1 (not (g/bvalue e1))))

      (g/label! 20.0 82.0 400.0 20.0 "GuiValueBox - typing only")
      (when (pos? (g/value-box! 150.0 106.0 150.0 30.0 "volume  " volume 0 100 (g/bvalue e2)))
        (g/breset! e2 (not (g/bvalue e2))))

      (g/line! 20.0 148.0 400.0 16.0 "third spinner seeded at 999, max 50")
      (when (pos? (g/spinner! 150.0 170.0 150.0 30.0 "clamped  " clamped 0 50 (g/bvalue e3)))
        (g/breset! e3 (not (g/bvalue e3))))

      (g/status-bar! 0.0 (- HEIGHT 24.0) (+ 0.0 WIDTH) 24.0
                     (str "  count " (g/ivalue count')
                          "   volume " (g/ivalue volume)
                          "   clamped " (g/ivalue clamped)))

      (when (zero? frame) (rl/maybe-screenshot! shot))
      (cpp/EndDrawing)
      (when (rl/keep-running? deadline)
        (recur (inc frame)))))
  (cpp/CloseWindow))
