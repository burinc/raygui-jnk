(ns net.b12n.raygui-jnk.color-picker
  "raygui [color] - an RGB picker with an alpha bar.

  GuiColorPicker takes a Color* cell. cpp/new already yields a pointer, so
  the cell must NOT have its address taken again -- that gives Color** and a
  'No matching call' error naming three argument types without saying which
  is wrong.

  The swatch beside the picker is drawn from the cell's own components, so a
  readback that failed would be visible in the screenshot rather than only in
  a log. The cell is seeded a distinctive orange for the same reason: a grey
  or black seed would look the same as an unwired one."
  (:require [net.b12n.raygui-jnk.raygui :as g]
            [net.b12n.raygui-jnk.raylib :as rl])
  (:include "raylib.h" "rlgl.h"))

(def WIDTH 500)
(def HEIGHT 320)

(defn -main [& args]
  (cpp/InitWindow WIDTH HEIGHT "raygui [color] - color picker (jank)")
  (cpp/SetTargetFPS 60)
  (let [deadline (rl/auto-quit-ms)
        shot     (rl/shot-path)
        col      (g/ccell 230 126 34 255)
        alpha    (g/fcell 0.8)]
    (loop [frame 0]
      (cpp/BeginDrawing)
      (g/clear-background!)

      (g/label! 20.0 12.0 460.0 20.0 "GuiColorPicker - panel plus a hue bar:")
      (g/color-picker! 20.0 38.0 200.0 200.0 nil col)

      (g/label! 20.0 250.0 200.0 20.0 "GuiColorBarAlpha")
      (g/color-bar-alpha! 20.0 272.0 200.0 22.0 nil alpha)

      (let [rgba (g/cvalue col)
            r (nth rgba 0) gg (nth rgba 1) b (nth rgba 2)
            a (int (* 255.0 (g/fvalue alpha)))]
        ;; Built inline as an argument: a Color never crosses a fn boundary.
        (cpp/DrawRectangle 270 38 200 100
                           (cpp/Color (cpp/cast cpp/uint8_t r) (cpp/cast cpp/uint8_t gg)
                                      (cpp/cast cpp/uint8_t b) (cpp/cast cpp/uint8_t 255)))
        (cpp/DrawRectangleLines 270 38 200 100 cpp/DARKGRAY)

        (g/label! 270.0 150.0 200.0 20.0 (str "r: " r))
        (g/label! 270.0 174.0 200.0 20.0 (str "g: " gg))
        (g/label! 270.0 198.0 200.0 20.0 (str "b: " b))
        (g/line! 270.0 222.0 200.0 12.0 nil)
        (g/label! 270.0 240.0 200.0 20.0 (str "alpha: " a "/255"))

        ;; The same colour again, this time honouring the alpha bar, over a
        ;; chequer so the transparency is actually visible.
        (loop [i 0]
          (when (< i 8)
            (loop [j 0]
              (when (< j 2)
                (when (zero? (mod (+ i j) 2))
                  (cpp/DrawRectangle (cpp/int (+ 270 (* i 25))) (cpp/int (+ 272 (* j 11)))
                                     25 11 cpp/LIGHTGRAY))
                (recur (inc j))))
            (recur (inc i))))
        (cpp/DrawRectangle 270 272 200 22
                           (cpp/Color (cpp/cast cpp/uint8_t r) (cpp/cast cpp/uint8_t gg)
                                      (cpp/cast cpp/uint8_t b) (cpp/cast cpp/uint8_t a)))
        (cpp/DrawRectangleLines 270 272 200 22 cpp/DARKGRAY))

      (when (zero? frame) (rl/maybe-screenshot! shot))
      (cpp/EndDrawing)
      (when (rl/keep-running? deadline)
        (recur (inc frame)))))
  (cpp/CloseWindow))
