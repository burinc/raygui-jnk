(ns net.b12n.raygui-jnk.check
  "The headless compile gate.

  Requiring an example namespace compiles it without running its -main, so
  this one namespace compiles the whole suite and opens no window. In jank
  that is a real compile, not a load: it catches the codegen failures no
  reader-level syntax check can see.

  Every example must be added here as it lands. `bb examples` reports any
  registry row whose namespace is missing from this list."
  (:require [net.b12n.raygui-jnk.basic-controls]
            [net.b12n.raygui-jnk.toggles]
            [net.b12n.raygui-jnk.labels-lines]
            [net.b12n.raygui-jnk.icon-buttons]
            [net.b12n.raygui-jnk.text-box]
            [net.b12n.raygui-jnk.text-input-box]
            [net.b12n.raygui-jnk.spinner-value-box]
            [net.b12n.raygui-jnk.sliders]
            [net.b12n.raygui-jnk.progress-bar]
            [net.b12n.raygui-jnk.dropdown-box]
            [net.b12n.raygui-jnk.combo-box]
            [net.b12n.raygui-jnk.list-view]
            [net.b12n.raygui-jnk.list-view-ex]
            [net.b12n.raygui-jnk.tab-bar]
            [net.b12n.raygui-jnk.panel-group-box]
            [net.b12n.raygui-jnk.scroll-panel]
            [net.b12n.raygui-jnk.window-box]
            [net.b12n.raygui-jnk.floating-window]))

(def required
  "The namespaces this gate covers, for `bb check` to report against."
  ['net.b12n.raygui-jnk.basic-controls
   'net.b12n.raygui-jnk.toggles
   'net.b12n.raygui-jnk.labels-lines
   'net.b12n.raygui-jnk.icon-buttons
   'net.b12n.raygui-jnk.text-box
   'net.b12n.raygui-jnk.text-input-box
   'net.b12n.raygui-jnk.spinner-value-box
   'net.b12n.raygui-jnk.sliders
   'net.b12n.raygui-jnk.progress-bar
   'net.b12n.raygui-jnk.dropdown-box
   'net.b12n.raygui-jnk.combo-box
   'net.b12n.raygui-jnk.list-view
   'net.b12n.raygui-jnk.list-view-ex
   'net.b12n.raygui-jnk.tab-bar
   'net.b12n.raygui-jnk.panel-group-box
   'net.b12n.raygui-jnk.scroll-panel
   'net.b12n.raygui-jnk.window-box
   'net.b12n.raygui-jnk.floating-window])

(defn -main [& args]
  (println (str "check: " (count required) " example namespaces compiled"))
  (doseq [n required] (println (str "  " n))))
