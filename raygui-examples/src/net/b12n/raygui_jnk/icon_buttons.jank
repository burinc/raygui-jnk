(ns net.b12n.raygui-jnk.icon-buttons
  "raygui [basics] - the embedded 1-bit icon pack on buttons.

  GuiIconText composes an icon id with a label; raygui owns the returned
  string in a static ring buffer, so it is used immediately as a button label
  and never stored. GuiDrawIcon draws one directly at a scale set by
  GuiSetIconScale.

  draw-icon! takes r/g/b/a rather than a Color: a native struct cannot cross a
  jank fn boundary."
  (:require [net.b12n.raygui-jnk.raygui :as g]
            [net.b12n.raygui-jnk.raylib :as rl])
  (:include "raylib.h" "rlgl.h"))

(def WIDTH 460)
(def HEIGHT 300)

;; [icon-id label] - ids from the RAYGUI_ICON_* enum in vendor/raygui.h
(def buttons
  [[6   "Save"]
   [3   "Open"]
   [141 "Settings"]
   [157 "Star"]
   [112 "Accept"]
   [113 "Cancel"]])

(defn -main [& args]
  (cpp/InitWindow WIDTH HEIGHT "raygui [basics] - icon buttons (jank)")
  (cpp/SetTargetFPS 60)
  (let [deadline (rl/auto-quit-ms)
        shot     (rl/shot-path)
        last-hit (g/icell -1)]
    (loop [frame 0]
      (cpp/BeginDrawing)
      (g/clear-to-style! cpp/DEFAULT cpp/BACKGROUND_COLOR)

      (g/label! 20.0 12.0 420.0 20.0 "GuiIconText on buttons:")

      ;; loop/recur, not doseq: a closure is a fn boundary, and keeping the
      ;; frame's drawing inline is the habit that avoids surprises later.
      (loop [i 0]
        (when (< i (count buttons))
          (let [row  (nth buttons i)
                col  (mod i 3)
                rw   (quot i 3)
                x    (+ 20.0 (* col 145.0))
                y    (+ 40.0 (* rw 48.0))]
            (when (g/button! x y 135.0 38.0 (g/icon-text (nth row 0) (nth row 1)))
              (g/ireset! last-hit i)))
          (recur (inc i))))

      (g/line! 20.0 140.0 420.0 16.0 "GuiDrawIcon at scale 3")
      (g/set-icon-scale! 3)
      (g/draw-icon! 186 40 170 3 200 60 60 255)     ;; ICON_HEART
      (g/draw-icon! 131 130 170 3 60 120 200 255)   ;; ICON_PLAYER_PLAY
      (g/draw-icon! 191 220 170 3 90 90 90 255)     ;; ICON_INFO
      (g/draw-icon! 217 310 170 3 190 150 40 255)   ;; ICON_FOLDER
      (g/set-icon-scale! 1)

      (g/status-bar! 0.0 (- HEIGHT 24.0) (+ 0.0 WIDTH) 24.0
                     (let [i (g/ivalue last-hit)]
                       (if (neg? i)
                         "  click a button"
                         (str "  pressed: " (nth (nth buttons i) 1)))))

      (when (zero? frame) (rl/maybe-screenshot! shot))
      (cpp/EndDrawing)
      (when (rl/keep-running? deadline)
        (recur (inc frame)))))
  (cpp/CloseWindow))
