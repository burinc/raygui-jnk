;; raygui-jnk task runner.
;;
;;   bb info                every task, grouped: gates, package, examples
;;   bb examples            the suite, grouped, with the 49-char cap enforced
;;   bb check               compile every example headless -- the fast gate
;;   bb check:registration  source, profile and check.jank entries agree
;;   bb lint                clj-kondo
;;   bb <example-name>      run one, windowed
;;   bb run <name>          same, by argument
;;   bb shot <name> [ms]    run headless and screenshot to /tmp/<name>.png
;;   bb run-all [secs]      cycle every example, secs of window each (demo reel)
;;   bb readme:examples     regenerate the README gallery from the registry
;;   bb sys:install         lein install raygui-sys to ~/.m2
;;   bb hooks:install       pre-commit hook
;;
;; NOTE: task bodies are read by babashka's EDN reader, which does NOT support
;; #"regex", @deref, or #(...) reader macros -- use (re-pattern "..."),
;; (deref ...) and (fn [x] ...). Run `bb tasks` after editing to confirm the
;; file still parses.
;;
;; NOTE: every lein invocation passes --disable-sandbox. macOS has no bwrap,
;; so lein-jank's build sandbox cannot work there at all.
{:min-bb-version "1.3.0"
 :paths ["scripts"]

 :tasks
 {:init
  (do
    (require '[babashka.fs :as fs]
             '[babashka.process :as proc]
             '[clojure.string :as str]
             '[clojure.edn :as edn]
             '[examples-registry :as reg]
             '[readme-tools :as rt]
             '[registration :as regi])

    (def repo-root (str (fs/parent (fs/absolutize "bb.edn"))))
    (def examples-dir (str (fs/path repo-root "raygui-examples")))
    (def sys-dir (str (fs/path repo-root "raygui-sys")))

    ;; proc/shell with an opts map treats a following vector as ONE argument
    ;; ("[lein"), so the command must be applied, not passed as a vector.
    ;; LEIN overrides the executable, for a PATH lein that cannot bootstrap.
    (def lein-bin (or (System/getenv "LEIN") "lein"))

    (defn lein [dir args]
      (apply proc/shell {:dir dir} lein-bin args))

    (defn run-example
      "Runs one example windowed. Q or the window close button quits."
      [name]
      (lein examples-dir ["with-profile" (str "+" name) "run" "--disable-sandbox"]))

    (defn shot-example
      "Runs one example headless and screenshots it.

       The PNG is the gate for this project: a control at wrong bounds, or a
       style that silently failed to load, compiles clean and passes check."
      [name ms]
      (let [out (str "/tmp/" name ".png")]
        (fs/delete-if-exists out)
        (apply proc/shell
               {:dir examples-dir
                :extra-env {"RAYGUI_APP_AUTO_QUIT_MS" (str ms)
                            "RAYGUI_APP_SHOT" out
                            "RAYGUI_STYLES_DIR" (str (fs/path sys-dir "vendor" "styles"))}}
               lein-bin ["with-profile" (str "+" name) "run" "--disable-sandbox"])
        (if (fs/exists? out)
          (println (str "  wrote " out))
          (do (binding [*out* *err*]
                (println (str "  NO SCREENSHOT for " name " -- look at the log above")))
              (System/exit 1)))))

    (defn registered-names [] (mapv (fn [r] (nth r 0)) reg/examples))

    (defn run-example-timed!
      "Runs one example with its own auto-quit deadline, so it closes itself.

       This reuses the deadline the gates use rather than killing the process:
       the example shuts raylib down cleanly on its way out, and Q still skips
       ahead early."
      [name secs]
      (apply proc/shell
             {:dir examples-dir :continue true
              :extra-env {"RAYGUI_APP_AUTO_QUIT_MS" (str (* 1000 secs))
                          "RAYGUI_STYLES_DIR" (str (fs/path sys-dir "vendor" "styles"))}}
             lein-bin ["with-profile" (str "+" name) "run" "--disable-sandbox"]))

    (defn task-names
      "The task keys declared in this file. bb.edn is itself EDN, so it can be
       read back rather than introspected through the runtime."
      []
      (set (map name (keys (:tasks (edn/read-string (slurp (str (fs/path repo-root "bb.edn"))))))))))

  examples
  {:doc "Every example with its description, grouped"
   :task
   (let [w (reg/max-name-width)
         over (reg/check-descriptions)
         tasks (task-names)]
     (doseq [g reg/groups]
       (println (str "  " g))
       (doseq [row (get (reg/by-group) g)]
         (println (str "    " (reg/pad (nth row 0) w) "  " (nth row 3))))
       (println ""))
     (println (str "  " (count reg/examples) " examples in " (count reg/groups) " groups"))
     (let [pending (remove tasks (registered-names))]
       (when (seq pending)
         (println (str "  " (count pending) " not yet ported: " (str/join ", " pending)))))
     (let [drift (reg/doc-mismatches)]
       (when (seq drift)
         (binding [*out* *err*]
           (println "")
           (println "bb.edn :doc disagrees with the registry description:")
           (doseq [[n expected actual] drift]
             (println (str "  " n))
             (println (str "    registry: " expected))
             (println (str "    bb.edn:   " actual)))
           (System/exit 1))))
     (when (seq over)
       (binding [*out* *err*]
         (println "")
         (println "Descriptions over the 49-character cap:")
         (doseq [[n len] over] (println (str "  " n " (" len ")")))
         (System/exit 1))))}

  check
  {:doc "Compile every ported example, headless"
   :task (lein examples-dir ["with-profile" "+check" "run" "--disable-sandbox"])}

  check:registration
  {:doc "Source, profile and check.jank entries agree with the registry"
   ;; The offline companion to `check`, and the gate `check` cannot be for
   ;; itself.
   ;;
   ;; An example left out of check.jank's :require is never compiled by
   ;; `bb check`, which then prints success and a count that silently excludes
   ;; it. A green compile gate over code it never read is worse than no gate,
   ;; so the registration gets verified separately, without a compiler.
   :task
   (let [probs (regi/problems repo-root (task-names))]
     (if (seq probs)
       (binding [*out* *err*]
         (println "registration gaps:")
         (doseq [[n what] probs] (println (str "  " n ": " what)))
         (System/exit 1))
       (println (str "registration ok, "
                     (count (filterv (task-names) (registered-names)))
                     " examples across source, profile and check.jank"))))}

  lint
  {:doc "clj-kondo over both projects"
   ;; clj-kondo does NOT discover .jank files: --lint on a directory scans for
   ;; .clj/.cljs/.cljc, finds nothing, and reports "0 warnings" very fast --
   ;; a green gate that linted nothing at all. Pass every file explicitly.
   :task
   (let [files (concat (map str (fs/glob repo-root "raygui-sys/src/**/*.jank"))
                       (map str (fs/glob repo-root "raygui-examples/src/**/*.jank"))
                       (map str (fs/glob repo-root "scripts/**.clj")))]
     (println (str "linting " (count files) " files"))
     ;; clj-kondo exits 0 clean, 2 on warnings, 3 on errors. Without this the
     ;; task succeeds on warnings and the pre-commit hook waves them through --
     ;; which it did, letting two unresolved-namespace warnings land.
     (let [{:keys [exit]} (apply proc/shell {:dir repo-root :continue true}
                                 "clj-kondo" "--lint" files)]
       (when-not (zero? exit)
         (System/exit exit))))}

  sys:install
  {:doc "Install raygui-sys to ~/.m2 (run after editing the wrapper)"
   ;; Also drops the consuming project's cached build output for this package.
   ;;
   ;; lein-jank keys a dependency's out-dir on (fingerprint subtree-ops) --
   ;; the fingerprint of its DESCENDANTS' build ops, not of its own source.
   ;; So changing this package's C source produces a new jar and a freshly
   ;; extracted source dir, but out-dir is unchanged, is-already-built? still
   ;; sees its cache file, and jank-build.bb never runs: the stale
   ;; libraygui.dylib is reused with no warning. Measured 2026-08-26.
   ;;
   ;; Editing the .jank sources is unaffected -- those are compiled from the
   ;; re-extracted classpath every run. This only bites vendored C.
   :task
   (do
     (lein sys-dir ["install"])
     (doseq [d (fs/glob (fs/path examples-dir "target" "_cache")
                        "raygui-sys-*" {:max-depth 1})]
       (println (str "  dropping stale build output " (fs/file-name d)))
       (fs/delete-tree d)))}

  run
  {:doc "Run an example by name: bb run basic-controls"
   :override-builtin true
   :task (let [n (first *command-line-args*)]
           (if n
             (run-example n)
             (do (binding [*out* *err*] (println "usage: bb run <example-name>"))
                 (System/exit 1))))}

  shot
  {:doc "Screenshot an example: bb shot basic-controls [ms]"
   :task (let [n (first *command-line-args*)
               ms (or (second *command-line-args*) "1200")]
           (if n
             (shot-example n ms)
             (do (binding [*out* *err*] (println "usage: bb shot <example-name> [ms]"))
                 (System/exit 1))))}

  hooks:install
  {:doc "Install a pre-commit hook running the three offline gates"
   ;; Both are sub-second. CI runs them too, on every pull request and on
   ;; main, so the hook is what catches a stale gallery before the commit
   ;; rather than after the push.
   :task
   (let [p (fs/path repo-root ".git" "hooks" "pre-commit")]
     (spit (str p) "#!/bin/sh\nset -e\nbb lint\nbb check:registration\nbb readme:examples-check\n")
     (fs/set-posix-file-permissions p "rwxr-xr-x")
     (println (str "installed " p)))}

  info
  {:doc "Every task, grouped. Easier to scan than the flat bb tasks."
   :task
   (let [w (max 18 (reg/max-name-width))
         line (fn [n d] (println (str "  bb " (reg/pad n w) "  " d)))
         tasks (task-names)]
     (println "")
     (println "gates")
     (line "check" "compile every ported example, headless")
     (line "check:registration" "source, profile and check.jank entries agree")
     (line "lint" "clj-kondo over every .jank file, fails on warnings")
     (line "examples" "the suite, grouped, with the description cap enforced")
     (println "")
     (println "package")
     (line "sys:install" "install raygui-sys to ~/.m2 after editing the wrapper")
     (line "hooks:install" "install the pre-commit hook")
     (println "")
     (println "running")
     (line "<example-name>" "run one, windowed. Q quits.")
     (line "run <name>" "the same, by argument")
     (line "shot <name> [ms]" "run headless and screenshot to /tmp/<name>.png")
     (line "run-all [secs]" "cycle every example, a demo reel")
     (doseq [g reg/groups]
       (println "")
       (println g)
       (doseq [row (get (reg/by-group) g)]
         (let [n (nth row 0)]
           (line (if (contains? tasks n) n (str n " (not ported)")) (nth row 3)))))
     (println ""))}

  run-all
  {:doc "Cycle every example, secs of window each: bb run-all [secs]"
   :task
   (let [secs (or (some-> (first *command-line-args*) parse-long) 8)
         names (filterv (task-names) (registered-names))
         total (count names)]
     (println (str "running " total " examples, " secs "s of window each"))
     (println "Q or the close button skips to the next one early.")
     ;; Measured on an M1 Pro: about 7s of lein start, compile and launch
     ;; before each window appears, on top of the window time itself. A cold
     ;; first run is longer, since raygui and raylib build then.
     (println (str "Roughly " (+ 7 secs) "s each including launch, so about "
                   (quot (* total (+ 7 secs)) 60) " minutes total."))
     (loop [i 0]
       (when (< i total)
         (let [n (nth names i)]
           (println "")
           (println (str "  [" (inc i) "/" total "] " n))
           (run-example-timed! n secs))
         (recur (inc i))))
     (println "")
     (println (str "cycled through " total " examples")))}

  readme:examples
  {:doc "Regenerate the README example gallery from the registry"
   :task
   (let [missing (rt/missing-demos repo-root)]
     (if (seq missing)
       (binding [*out* *err*]
         (println "missing screenshots, run bb shot <name> for each:")
         (doseq [row missing] (println (str "  " (rt/demo-path (nth row 0)))))
         (System/exit 1))
       (let [path (str (fs/path repo-root "README.md"))
             text (slurp path)]
         (if-let [spliced (rt/splice text (rt/html))]
           (do (spit path spliced)
               (println (str "README gallery regenerated, "
                             (count reg/examples) " examples")))
           (binding [*out* *err*]
             (println "README markers not found. Expected both of:")
             (println (str "  " rt/begin-marker))
             (println (str "  " rt/end-marker))
             (System/exit 1))))))}

  readme:examples-check
  {:doc "Fail if the README gallery is stale or a screenshot is missing"
   :task
   (let [missing (rt/missing-demos repo-root)]
     (when (seq missing)
       (binding [*out* *err*]
         (println "missing screenshots:")
         (doseq [row missing] (println (str "  " (rt/demo-path (nth row 0)))))
         (System/exit 1)))
     (let [text (slurp (str (fs/path repo-root "README.md")))
           cur  (rt/current-block text)]
       (cond
         (nil? cur)
         (binding [*out* *err*]
           (println "README markers not found; run bb readme:examples")
           (System/exit 1))

         (not= cur (rt/html))
         (binding [*out* *err*]
           (println "README gallery is stale; run bb readme:examples")
           (System/exit 1))

         :else
         (println (str "README gallery matches the registry, "
                       (count reg/examples) " examples")))))}

  docs-sync
  {:doc "Republish the docs: rebuild -> push site repo -> mirror to wiki -> S3 + CloudFront. Maintainer task (needs sibling repos, AWS_PROFILE=b12n). bb docs-sync [--no-push]"
   ;; Never force-pushes or auto-rebases: if a target is behind, it says so
   ;; and stops. --no-push commits locally and publishes nothing.
   ;;
   ;; Do NOT place docs/CNAME by hand - the b12n-docs engine writes it from
   ;; :cname, and `bb site:build` wipes the output dir first, so a hand-placed
   ;; one survives exactly one build. It is inert either way: CNAME is a
   ;; GitHub Pages mechanism, Pages is not enabled, and the live site is
   ;; served from S3 behind CloudFront. site-host below plus the CloudFront
   ;; alias are what determine the URL.
   ;;
   ;; The AWS CLI honours HTTPS_PROXY, and on a restricted network that proxy
   ;; swallows every call while git and DNS keep working. deploy! classifies
   ;; that case rather than blaming missing infrastructure. See its comments.
   :task
   (let [push?     (not (some (fn [a] (= a "--no-push")) *command-line-args*))
         home      (System/getProperty "user.home")
         proj-dir  (System/getProperty "user.dir")
         docs-repo (str home "/dev/b12n-docs")
         site-repo (str home "/dev/raygui-jnk.github.io")
         wiki-repo (str home "/dev/b12n-wikis")
         wiki-dir  (str wiki-repo "/raygui-jnk")
         guide-dir (str proj-dir "/docs/guide")
         bucket    "b12n-site-raygui-jnk"
         site-host "raygui-jnk.b12n.app"
         hdr       (fn [label] (println (str "\n── " label " ──")))
         dirty?    (fn [dir path]
                     (let [res (shell {:dir dir :out :string} "git" "status" "--short" "--" path)]
                       (not (str/blank? (:out res)))))
         ;; Returns a keyword rather than exiting, so one repo's failure does not
         ;; block the other. `git add`/`git commit` are scoped to `path` - never
         ;; -A/. - because b12n-wikis is shared across many projects and a stray
         ;; staged file must not ride along. Commit and push are checked separately,
         ;; so a commit left unpushed by an earlier run is still pushable later.
         sync!     (fn [opts]
                     (let [label (:label opts) dir (:dir opts)
                           path (:path opts) msg (:msg opts)]
                       (hdr label)
                       (let [committed? (if (dirty? dir path)
                                          (do (shell {:dir dir} "git" "add" "--" path)
                                              (shell {:dir dir} "git" "commit" "-m" msg "--" path)
                                              true)
                                          false)]
                         (if-not push?
                           (do (println (if committed?
                                          "  committed locally (--no-push)"
                                          "  nothing to commit (--no-push)"))
                               :ok)
                           (do
                             (shell {:dir dir :continue true} "git" "fetch" "origin")
                             ;; One status read, used for both checks, so a
                             ;; diverged branch cannot slip between them.
                             (let [st (:out (shell {:dir dir :out :string} "git" "status" "--short" "--branch"))]
                               (cond
                                 (str/includes? st "behind")
                                 (do (println (str "  BEHIND origin — resolve manually (cd " dir " && git pull --rebase), not auto-pushing"))
                                     :behind)

                                 ;; No upstream = no ahead/behind in the status line, so the check below
                                 ;; would silently read as "nothing to push". filter-repo drops the remote,
                                 ;; so a repo can land here after a history rewrite.
                                 (not (str/includes? st "..."))
                                 (do (println (str "  NO UPSTREAM for main in " dir " — not pushing."))
                                     (println "  Fix with: git branch --set-upstream-to=origin/main main")
                                     :no-upstream)

                                 (not (str/includes? st "ahead"))
                                 (do (println "  up to date, nothing to push") :skipped)

                                 :else
                                 (let [pr (shell {:dir dir :continue true} "git" "push" "origin" "main")]
                                   (if (zero? (:exit pr))
                                     (do (println (if committed?
                                                    "  committed + pushed"
                                                    "  pushed (commit was already local)"))
                                         :ok)
                                     (do (println "  PUSH FAILED") :push-failed))))))))))
         ;; Publishes the BUILT site to the S3 origin behind CloudFront, then
         ;; invalidates the edge. Infra lives in ~/dev/b12n-infra
         ;; (resources/static-site/raygui-jnk.edn); this skips with an explanation if
         ;; the aws CLI or the bucket is not there yet.
         ;;
         ;; The distribution id is looked up by alias, never hardcoded - tofu owns
         ;; it, and a stale id would invalidate someone else's site.
         deploy!   (fn []
                     (hdr "4/4 Deploy to S3 + CloudFront")
                     (cond
                       (not push?)
                       (do (println "  skipped (--no-push publishes nothing outward)") :deploy-disabled)

                       (not (fs/which "aws"))
                       (do (println "  DEPLOY SKIPPED - aws CLI not on PATH.") :aws-missing)

                       :else
                       (let [probe (shell {:continue true :out :string :err :string}
                                          "aws" "s3api" "head-bucket"
                                          "--bucket" bucket "--profile" "b12n")]
                         (if-not (zero? (:exit probe))
                           ;; head-bucket failing does NOT by itself mean the bucket is missing.
                           ;; It fails identically when the CLI cannot reach AWS at all - and on a
                           ;; restricted laptop HTTPS_PROXY is set, which the AWS CLI honours, so
                           ;; every call dies at the proxy while DNS and git keep working. Sending
                           ;; someone to tofu:apply for that means creating infrastructure that
                           ;; already exists. So classify the failure before advising anything.
                           (let [err   (str/lower-case (str (:err probe) " " (:out probe)))
                                 said  (first (str/split-lines (str/trim (str (:err probe) (:out probe)))))
                                 hit?  (fn [ss] (some (fn [s] (str/includes? err s)) ss))
                                 proxy (or (System/getenv "HTTPS_PROXY") (System/getenv "https_proxy"))]
                             (cond
                               (hit? ["proxy" "could not connect" "connect timeout" "endpoint url"
                                      "name resolution" "network is unreachable" "connection refused"
                                      "timed out" "connection was closed"])
                               (do (println "  DEPLOY SKIPPED - could not reach AWS at all.")
                                   (println (str "    " said))
                                   (println "  This is a network problem on THIS MACHINE. It is NOT evidence")
                                   (println "  about whether the bucket exists - do NOT run tofu:apply for it.")
                                   (when proxy
                                     (println (str "  HTTPS_PROXY is set (" proxy ") and the AWS CLI honours it.")))
                                   (println "  On a restricted laptop that proxy is the usual cause. Retry with:")
                                   (println "    unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy && bb docs-sync")
                                   :unreachable)

                               (hit? ["unable to locate credentials" "no credentials" "expiredtoken"
                                      "expired" "invalidclienttokenid" "signaturedoesnotmatch"
                                      "sso session" "token has expired"])
                               (do (println "  DEPLOY SKIPPED - AWS credentials for profile b12n are missing or expired.")
                                   (println (str "    " said))
                                   (println "  Refresh them and re-run. The infrastructure is unaffected.")
                                   :credentials)

                               (hit? ["403" "forbidden" "accessdenied"])
                               (do (println (str "  DEPLOY SKIPPED - s3://" bucket " EXISTS but profile b12n cannot read it (403)."))
                                   (println (str "    " said))
                                   (println "  That is a permissions problem, not missing infrastructure.")
                                   :forbidden)

                               (hit? ["404" "not found" "nosuchbucket"])
                               (do (println (str "  DEPLOY SKIPPED - s3://" bucket " does not exist."))
                                   (println "  THIS is the one that needs infrastructure. Run once in ~/dev/b12n-infra:")
                                   (println "    bb render lock tofu:init tofu:plan tofu:apply -- static-site raygui-jnk")
                                   :missing-bucket)

                               :else
                               (do (println (str "  DEPLOY SKIPPED - head-bucket on s3://" bucket " failed for an unrecognized reason."))
                                   (println (str "    " said))
                                   (println "  Check by hand before assuming anything:")
                                   (println (str "    aws s3api head-bucket --bucket " bucket " --profile b12n"))
                                   :probe-failed)))
                           (let [sync-res (shell {:continue true}
                                                 "aws" "s3" "sync" (str site-repo "/docs/")
                                                 (str "s3://" bucket "/")
                                                 "--profile" "b12n" "--delete")]
                             (if-not (zero? (:exit sync-res))
                               (do (println "  S3 SYNC FAILED") :sync-failed)
                               (let [q (str "DistributionList.Items[?contains(Aliases.Items, `" site-host "`)].Id | [0]")
                                     dist (shell {:continue true :out :string}
                                                 "aws" "cloudfront" "list-distributions"
                                                 "--profile" "b12n" "--query" q "--output" "text")
                                     id (str/trim (or (:out dist) ""))]
                                 (if (or (str/blank? id) (= id "None"))
                                   (do (println (str "  synced, but no CloudFront distribution found for " site-host))
                                       (println "  (cache not invalidated \u2014 edge may serve stale files for a while)")
                                       :no-distribution)
                                   (let [inv (shell {:continue true}
                                                    "aws" "cloudfront" "create-invalidation"
                                                    "--profile" "b12n" "--distribution-id" id
                                                    "--paths" "/*")]
                                     (if (zero? (:exit inv))
                                       (do (println (str "  synced + invalidated (" id ") \u2014 https://" site-host)) :ok)
                                       (do (println "  synced, but INVALIDATION FAILED") :invalidation-failed)))))))))))]
     (hdr "1/4 Rebuild site")
     (let [res       (shell {:dir docs-repo :continue true} "bb" "site:build" "raygui-jnk")
           build-ok? (zero? (:exit res))]
       (when-not build-ok? (println "  bb site:build FAILED"))
       (let [site-result (if build-ok?
                           (sync! {:label "2/4 raygui-jnk.github.io" :dir site-repo :path "docs"
                                   :msg "chore: rebuild docs (bb docs-sync)"})
                           :build-failed)]
         (fs/create-dirs wiki-dir)
         (doseq [f (fs/glob guide-dir "*.md")]
           (fs/copy f (str wiki-dir "/" (fs/file-name f)) {:replace-existing true}))
         (let [wiki-result (sync! {:label "3/4 b12n-wikis" :dir wiki-repo :path "raygui-jnk"
                                   :msg "raygui-jnk: mirror docs/guide (bb docs-sync)"})]
           (let [deploy-result (deploy!)]
             (hdr "Summary")
             (println (str "  site:   " site-result))
             (println (str "  wiki:   " wiki-result))
             (println (str "  deploy: " deploy-result))
             ;; Allowlist, not denylist. The successes are :ok, :skipped (sync!'s
             ;; "up to date, nothing to push") and :deploy-disabled (--no-push).
             ;; Everything else exits non-zero. Stated as an allowlist so a failure
             ;; mode added later fails loudly by default instead of slipping through
             ;; as a silent success - which is exactly how a skipped deploy exited 0.
             (when-not (every? (fn [r] (contains? #{:ok :skipped :deploy-disabled} r))
                               [site-result wiki-result deploy-result])
               (System/exit 1)))))))}

  ;; ------------------------------------------------------------- examples
  ;; One task per ported example. The :doc must match the registry
  ;; description exactly; `bb examples` lists any registry row with no task.

  basic-controls
  {:doc "button, label and a live click counter"
   :task (run-example "basic-controls")}

  toggles
  {:doc "toggle, toggle group and toggle slider"
   :task (run-example "toggles")}

  labels-lines
